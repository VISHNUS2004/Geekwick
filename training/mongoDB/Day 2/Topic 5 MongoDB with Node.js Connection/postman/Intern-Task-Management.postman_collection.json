{
  "info": {
    "name": "Intern Task Management Backend",
    "_postman_id": "70f6beab-dc6a-4f9c-8d6d-4d2a71f5f001",
    "description": "Postman collection for the Day 2 MongoDB + Express assignment backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "departmentId",
      "value": ""
    },
    {
      "key": "internId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Create Department",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.data && response.data._id) {",
              "  pm.collectionVariables.set('departmentId', response.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"QA Demo\",\n  \"description\": \"Demo department for assignment testing\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/departments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "departments"
          ]
        }
      }
    },
    {
