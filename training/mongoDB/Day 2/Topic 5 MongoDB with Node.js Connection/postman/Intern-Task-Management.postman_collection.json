          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ],
          "query": [
            {
              "key": "department",
              "value": "HR"
            }
          ]
        }
      }
    },
    {
      "name": "Interns By Department Report",
      "request": {
        "method": "GET",
