        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Kumar\",\n  \"age\": 22,\n  \"email\": \"rahul.demo@example.com\",\n  \"mobile\": \"9876543210\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"skills\": [\"MongoDB\", \"Node.js\"],\n  \"address\": {\n    \"city\": \"Kolkata\",\n    \"state\": \"West Bengal\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/interns",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "interns"
          ]
        }
      }
    },
